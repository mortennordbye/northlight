{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8080/",
        "http://localhost:8080/blog/",
        "http://localhost:8080/blog/measuring/",
        "http://localhost:8080/docs/writing/",
        "http://localhost:8080/tags/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertMatrix": [
        {
          "_comment": "Everything except the taxonomy pages. SEO and best-practices measured at 1.00 on every one of these, so the bar is where the theme already is, not an aspiration.",
          "matchingUrlPattern": "^(?!.*/tags/).*$",
          "assertions": {
            "categories:seo": ["error", { "minScore": 1 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:performance": ["warn", { "minScore": 0.65 }]
          }
        },
        {
          "_comment": "Taxonomy pages set robots noindex in exampleSite on purpose, to keep thin pages out of the index. Lighthouse scores that as a crawlability failure, so SEO is not asserted here: the page is doing what it is configured to do. Everything else still applies.",
          "matchingUrlPattern": ".*/tags/.*",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:performance": ["warn", { "minScore": 0.65 }]
          }
        }
      ]
    }
  }
}
