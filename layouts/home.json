{{- /*
  The search index, fetched by the ⌘K modal in phase 6.

  Deliberately small: title, url, date, tags, a plain-text summary and a thumbnail.
  It is downloaded before the first search, so it pays for every byte. The full body
  is not included — for a blog-sized corpus, matching on title, tags and summary is
  enough, and shipping every post's prose would multiply the payload for a marginal
  gain in recall.
*/ -}}
{{- $index := slice -}}
{{- /* excludeFromSearch keeps a page out of the index without keeping it out of the
       site. Its sibling sitemap_exclude does the same for the sitemap; the two are
       separate because "do not index this" and "do not surface this in site search"
       are different intentions. */ -}}
{{- range where (where site.RegularPages "Section" "in" site.Params.mainSections) "Params.excludeFromSearch" "!=" true -}}
  {{- $thumb := "" -}}
  {{- with .Resources.GetMatch "{cover,featured}.*" -}}
    {{- $thumb = (partial "thumb.html" (dict "img" . "spec" "160x q70")).img.RelPermalink -}}
  {{- end -}}
  {{- $tags := slice -}}
  {{- range .GetTerms "tags" -}}
    {{- $tags = $tags | append (cond (ne .Data.Term "") .Data.Term .LinkTitle) -}}
  {{- end -}}
  {{- $index = $index | append (dict
      "title" .Title
      "url" .RelPermalink
      "date" (.Date.Format (partialCached "init.html" .).dateFormat)
      "readingTime" .ReadingTime
      "tags" $tags
      "summary" (cond (ne .Description "") .Description (.Summary | plainify | chomp))
      "thumb" $thumb
  ) -}}
{{- end -}}
{{- $index | jsonify -}}
